# Copie ce fichier en ".streamlit/secrets.toml" (même dossier, sans ".example")
# et remplis-le avec le contenu de ton fichier suivijudopro-a5ee1916d1ad.json
#
# ⚠️ Ne mets JAMAIS le vrai fichier secrets.toml sur GitHub, même dans un
# dépôt privé. Il est déjà exclu par le .gitignore fourni.
#
# Sur Streamlit Cloud, tu ne déposeras pas ce fichier : tu colleras les
# mêmes informations dans l'onglet "Secrets" des paramètres de l'appli.

MON_EMAIL = "ton.adresse@gmail.com"

[gcp_service_account]
type = "service_account"
project_id = "colle-ici-la-valeur-du-json"
private_key_id = "colle-ici-la-valeur-du-json"
private_key = "-----BEGIN PRIVATE KEY-----\nCOLLE-ICI-LA-CLE-COMPLETE\n-----END PRIVATE KEY-----\n"
client_email = "colle-ici-la-valeur-du-json"
client_id = "colle-ici-la-valeur-du-json"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "colle-ici-la-valeur-du-json"
universe_domain = "googleapis.com"
